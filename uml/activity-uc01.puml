@startuml
title UC-01 — Registrare un contratto di locazione

' Activity Diagram della procedura guidata di registrazione del contratto.
' Riferimenti principali: RF-01..RF-06, AC-01..AC-09.

|Sistema|
start
:Avvia procedura di registrazione;
:Verifica presenza di una bozza non conclusa;

if (Bozza presente?) then (sì)
  :Confronta progressivamente la bozza
con i contratti già registrati;
  note right
    Il confronto usa, quando presenti:
    dati catastali dell'Immobile,
    codice fiscale dell'Inquilino,
    periodo dal/al.
  end note

  if (Tutti i dati presenti e coincidenti
con un contratto registrato?) then (sì)
    :Elimina silenziosamente la bozza residua;
    :Avvia una nuova procedura;
  else (no)
    :Carica i dati della bozza;
    note right
      Gli step già validati risultano precompilati.
      La procedura riprende dal primo step
      non ancora completato.
    end note
  endif
else (no)
  :Avvia una nuova procedura;
endif

note right
  La procedura può essere annullata
  in qualunque momento prima della
  conferma definitiva.
  L'annullamento elimina l'eventuale
  bozza e non persiste i dati acquisiti o
  modificati esclusivamente nella procedura.
end note

' =========================================================
' STEP 1 — IMMOBILE
' =========================================================

repeat
  |Proprietario|
  :Step 1 — Seleziona un immobile esistente\no inserisce un nuovo immobile;

  |Sistema|
  if (Immobile selezionato?) then (sì)
    :Recupera l'immobile selezionato;

    if (Immobile trovato?) then (sì)
      :Accetta l'immobile selezionato;
    else (no)
      :Segnala immobile non disponibile;
    endif

  else (no)
    :Valida i dati del nuovo immobile;

    if (Dati validi?) then (sì)
      :Verifica duplicazione catastale;

      if (Combinazione catastale già presente?) then (sì)
        :Segnala duplicato catastale;
      else (no)

        if (Interno specificato?) then (sì)
          :Verifica duplicazione dell'indirizzo completo;

          if (Indirizzo completo già presente?) then (sì)
            :Segnala duplicato di indirizzo;
          else (no)
            :Accetta il nuovo immobile nella procedura;
          endif

        else (no)
          :Accetta il nuovo immobile nella procedura;
        endif
      endif

    else (no)
      :Segnala gli errori di validazione;
    endif
  endif

repeat while (Step 1 valido?) is (no) not (sì)

:Crea o aggiorna la bozza\ncon i dati dell'immobile;
note right
  Un eventuale nuovo Immobile
  resta nella bozza e non viene
  ancora salvato permanentemente.
end note

if (Proprietario annulla?) then (sì)
  :Elimina l'eventuale bozza;
  :Non salva permanentemente i dati acquisiti o modificati;
  stop
else (no)
endif

' =========================================================
' STEP 2 — PROPRIETARIO
' =========================================================

repeat
  |Proprietario|
  :Step 2 — Inserisce il codice fiscale\ndel proprietario;

  |Sistema|
  :Cerca la Persona tramite codice fiscale;

  if (Persona già registrata?) then (sì)
    :Recupera i dati della Persona;
    :Mostra i dati precompilati;

    |Proprietario|
    :Verifica ed eventualmente modifica\ndati anagrafici e residenza;
  else (no)
    |Sistema|
    :Richiede dati anagrafici e residenza;

    |Proprietario|
    :Inserisce i dati della nuova Persona;
  endif

  |Sistema|
  :Valida i dati della Persona;
  note right
    Per una Persona esistente il codice fiscale
    resta invariato; gli altri dati possono essere corretti.
  end note

  if (Dati validi?) then (sì)
    :Accetta la Persona nel ruolo di proprietario;
  else (no)
    :Segnala gli errori di validazione;
  endif

repeat while (Step 2 valido?) is (no) not (sì)

:Aggiorna la bozza con la working copy\ndel proprietario;
note right
  Una nuova Persona o le modifiche a una Persona
  esistente restano nella bozza fino alla conferma.
end note

if (Proprietario annulla?) then (sì)
  :Elimina la bozza;
  :Non salva permanentemente i dati acquisiti o modificati;
  stop
else (no)
endif

' =========================================================
' STEP 3 — INQUILINO
' =========================================================

repeat
  |Proprietario|
  :Step 3 — Inserisce il codice fiscale\ndell'inquilino;

  |Sistema|
  :Cerca la Persona tramite codice fiscale;

  if (Persona già registrata?) then (sì)
    :Recupera dati, residenza e documento disponibili;
    :Mostra i dati precompilati;

    |Proprietario|
    :Verifica ed eventualmente modifica\ndati anagrafici, residenza e documento;
  else (no)
    |Sistema|
    :Richiede dati anagrafici e residenza;

    |Proprietario|
    :Inserisce i dati della nuova Persona;
  endif

  |Sistema|
  :Valida i dati della Persona;

  if (Dati della Persona validi?) then (sì)
    if (Documento di riconoscimento presente e valido?) then (sì)
      :Accetta la Persona nel ruolo di inquilino;
    else (no)
      :Richiede o consente di correggere il documento;
      |Proprietario|
      :Inserisce o modifica i dati del documento;
      |Sistema|
      :Valida il documento;
      if (Documento valido?) then (sì)
        :Accetta la Persona nel ruolo di inquilino;
      else (no)
        :Segnala gli errori del documento;
      endif
    endif
  else (no)
    :Segnala gli errori dei dati della Persona;
  endif

repeat while (Step 3 valido?) is (no) not (sì)

:Aggiorna la bozza con la working copy\ndell'inquilino e del documento;
note right
  Nuovi dati e modifiche a dati esistenti restano
  nella bozza fino alla conferma definitiva.
end note

if (Proprietario annulla?) then (sì)
  :Elimina la bozza;
  :Non salva permanentemente i dati acquisiti o modificati;
  stop
else (no)
endif

' =========================================================
' STEP 4 — DATI CONTRATTUALI
' =========================================================

repeat
  |Proprietario|
  :Step 4 — Seleziona la tipologia e inserisce\nnome/descrizione, data dal, canone mensile\ne giorno di pagamento;

  |Sistema|
  :Valida i dati contrattuali;

  if (Dati validi?) then (sì)
    :Carica tipologia e articoli predefiniti;
    :Calcola la data al usando la durata iniziale;
    :Rende disponibili gli articoli predefiniti;
    note right
      Il valore di rinnovo descrive la tipologia,
      ma non viene applicato al periodo gestito
      nella versione 1.0. Le copie valorizzate
      degli articoli saranno create alla conferma
      usando i dati finali validati.
    end note
  else (no)
    :Segnala gli errori di validazione;
  endif

repeat while (Step 4 valido?) is (no) not (sì)

:Aggiorna la bozza\ncon dati contrattuali e tipologia;

if (Proprietario annulla?) then (sì)
  :Elimina la bozza;
  :Non salva permanentemente i dati acquisiti o modificati;
  stop
else (no)
endif

' =========================================================
' STEP 5 — RIEPILOGO
' STEP 6 — CONFERMA
' =========================================================

repeat
  |Sistema|
  :Step 5 — Mostra il riepilogo del contratto;

  |Proprietario|
  :Verifica i dati;

  while (Vuole modificare i dati?) is (sì)

    repeat
      :Seleziona uno degli step 1-4\ne modifica i dati;

      |Sistema|
      :Rivalida i dati modificati;

      if (Modifica valida?) then (sì)
        :Ricalcola gli eventuali dati derivati;
        :Aggiorna la bozza;
      else (no)
        :Segnala gli errori di validazione;
        |Proprietario|
        :Corregge i dati;
      endif

    repeat while (Modifica valida?) is (no) not (sì)

    |Sistema|
    :Mostra il riepilogo aggiornato;

    |Proprietario|
    :Verifica i dati aggiornati;

  endwhile (no)

  if (Proprietario annulla?) then (sì)
    |Sistema|
    :Elimina la bozza;
    :Non salva permanentemente i dati acquisiti o modificati;
    stop
  else (no)
  endif

  |Proprietario|
  :Step 6 — Conferma esplicitamente\nla registrazione;

  |Sistema|
  :Verifica la sovrapposizione del periodo\ncon i contratti dello stesso immobile;

  if (Periodo sovrapposto?) then (sì)
    :Impedisce la registrazione definitiva;
    :Mostra l'errore di sovrapposizione;
    :Mantiene disponibile la bozza;
  else (no)
    :Periodo disponibile;
  endif

repeat while (Periodo sovrapposto?) is (sì) not (no)

' =========================================================
' REGISTRAZIONE DEFINITIVA
' =========================================================

:Crea il Contratto dai dati finali validati;
:Valorizza copie degli articoli predefiniti;
:Associa gli articoli valorizzati al Contratto;
:Crea il ContrattoRegistrato\ncome copia storica completa;
:Crea il Pagamento della prima mensilità\n(competenza da dal, dataPagamento = dal,\nimporto calcolato per la competenza iniziale);

:Salva in modo coerente la registrazione definitiva,\ncompresi eventuali nuovi oggetti e modifiche validate\na Persone, residenze e DocumentiRiconoscimento;

if (Salvataggio definitivo riuscito?) then (sì)
  :Commit dei dati definitivi;
  :Tenta di eliminare la bozza;

  if (Eliminazione bozza riuscita?) then (sì)
    :Comunica registrazione completata;
    stop
  else (no)
    :Registra l'errore di cleanup;
    note right
      Il contratto resta validamente registrato.
      La bozza residua verrà riconosciuta
      alla successiva apertura tramite
      il confronto progressivo.
    end note
    :Comunica registrazione completata;
    stop
  endif
else (no)
  :Rollback della registrazione definitiva;
  :Non lascia dati definitivi salvati parzialmente;
  :Mantiene disponibile la bozza;
  :Comunica l'errore di registrazione;
  stop
endif

@enduml
