@startuml
title UC-01 — Registrare un contratto di locazione

|Sistema|
start
:Recupera le bozze non concluse;
:Elimina le eventuali bozze residue\ndi registrazioni già completate;

if (Restano bozze riprendibili?) then (sì)
  |Proprietario|
  :Visualizza le bozze con azioni\nRiprendi e Annulla, più Nuovo contratto;
  if (Annulla una bozza dall'elenco?) then (sì)
    |Sistema|
    :Elimina soltanto la bozza selezionata;
    |Proprietario|
    :Resta nella schermata iniziale UC-01;
  else (no)
    if (Riprende una bozza?) then (sì)
      |Sistema|
      :Carica la bozza selezionata;
      :Determina il primo step non completato\no il riepilogo se i primi quattro sono completi;
    else (no)
      :Avvia una nuova procedura senza idBozza;
    endif
  endif
else (no)
  :Avvia una nuova procedura senza idBozza;
endif

' =========================================================
' STEP 1 — IMMOBILE
' =========================================================
repeat
  |Proprietario|
  :Step 1 — Seleziona Immobile esistente\no inserisce nuovo Immobile;
  |Sistema|
  :Valida disponibilità, dati catastali\ne duplicati applicabili;
  if (Step 1 valido?) then (sì)
    :Crea o aggiorna la bozza;
  else (no)
    :Mostra errore;
  endif
repeat while (Step 1 valido?) is (no) not (sì)

' =========================================================
' STEP 2 — PROPRIETARIO
' =========================================================
repeat
  |Proprietario|
  :Step 2 — Cerca per codice fiscale\noppure sceglie Nuovo proprietario;
  if (Ricerca?) then (sì)
    |Sistema|
    :Recupera working copy dalla bozza\no dai dati definitivi;
    |Proprietario|
    :Verifica / modifica i dati consentiti;
  else (nuovo)
    :Inserisce direttamente codice fiscale,\ndati anagrafici, residenza e IBAN se disponibile;
  endif
  |Sistema|
  :Valida CF, età e distinzione dei ruoli;
  if (Persona inviata come nuova?) then (sì)
    :Verifica che il CF non appartenga\ngià a una Persona registrata;
  else (no)
  endif
  if (Dati validi?) then (sì)
    :Salva il proprietario nella bozza;
  else (no)
    :Mostra errore;
  endif
repeat while (Step 2 valido?) is (no) not (sì)

' =========================================================
' STEP 3 — INQUILINO
' =========================================================
repeat
  |Proprietario|
  :Step 3 — Cerca per codice fiscale\noppure sceglie Nuovo inquilino;
  if (Ricerca?) then (sì)
    |Sistema|
    :Recupera working copy e documento disponibile;
    |Proprietario|
    :Verifica / modifica dati e documento;
  else (nuovo)
    :Inserisce direttamente dati Persona e documento;
  endif
  |Sistema|
  :Valida CF, età e distinzione dei ruoli;
  :Valida dataRilascio <= oggiServer;
  :Valida dataScadenza > oggiServer;
  if (Persona inviata come nuova?) then (sì)
    :Verifica che il CF non appartenga\ngià a una Persona registrata;
  else (no)
  endif
  if (Dati validi?) then (sì)
    :Salva l'inquilino nella bozza;
  else (no)
    :Mostra errore;
  endif
repeat while (Step 3 valido?) is (no) not (sì)

' =========================================================
' STEP 4 — DATI CONTRATTUALI
' =========================================================
repeat
  |Proprietario|
  :Step 4 — Inserisce nome/descrizione, tipologia,\ndal, canone mensile e giorno di pagamento;
  |Sistema|
  :Carica la tipologia con i suoi articoli;
  if (Template richiede IBAN proprietario\ne IBAN assente?) then (sì)
    :Blocca lo step e richiede la correzione allo Step 2;
  else (no)
    :Valida i dati contrattuali;
    :Calcola al da dal e durata iniziale;
    :Salva tipologia e dati nella bozza;
  endif
repeat while (Step 4 valido?) is (no) not (sì)

' =========================================================
' STEP 5 — RIEPILOGO
' =========================================================
repeat
  |Sistema|
  :Step 5 — Rivalida la bozza completa;
  :Crea un Contratto transitorio;
  :Genera con lo stesso generatore l'HTML valorizzato;
  :Non registra dati definitivi;
  |Proprietario|
  :Visualizza riepilogo e articoli valorizzati;

  while (Vuole modificare uno step completato?) is (sì)
    :Seleziona direttamente Step 1..4 dalla navigazione;
    :Modifica i dati;
    |Sistema|
    :Rivalida e salva la sola bozza;
    :Rigenera l'anteprima;
    |Proprietario|
    :Torna al riepilogo aggiornato;
  endwhile (no)

  if (Sceglie Salva bozza ed esci?) then (sì)
    |Sistema|
    :Mantiene la bozza già salvata progressivamente;
    |Proprietario|
    :Torna alla schermata iniziale UC-01;
    stop
  else (no)
  endif

  if (Sceglie Annulla bozza?) then (sì)
    |Sistema|
    :Elimina soltanto la bozza corrente;
    :Non rende permanenti i dati temporanei;
    |Proprietario|
    :Torna alla schermata iniziale UC-01;
    stop
  else (Conferma e registra)
  endif

  |Sistema|
  :Ricarica e rivalida la bozza con la data corrente;
  :Ricostruisce il Contratto dai dati finali;
  :Verifica la sovrapposizione del periodo;

  if (Periodo sovrapposto?) then (sì)
    :Mostra errore e mantiene la bozza;
    :Registrazione non completata;
  else (no)
    :Rigenera il documento HTML definitivo;
    :Imposta contenuto storico e registratoIl;
    :Crea il Pagamento della prima mensilità;
    :Registra definitivamente in una transazione;

    if (Registrazione riuscita?) then (sì)
      :Commit dei dati definitivi;
      :Tenta il cleanup della sola bozza corrente;
      note right
        Un errore di cleanup non invalida
        il Contratto già registrato.
      end note
      :Comunica registrazione completata;
    else (no)
      :Rollback della registrazione definitiva;
      :Mantiene la bozza disponibile;
      :Comunica l'errore;
    endif
  endif
repeat while (Registrazione completata?) is (no) not (sì)
stop

@enduml
