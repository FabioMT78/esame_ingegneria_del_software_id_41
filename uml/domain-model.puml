@startuml

title Gestionale Affitti — Domain Model

left to right direction
hide methods
hide stereotypes
skinparam classAttributeIconSize 0

class Persona {
  nome
  cognome
  luogoNascita
  dataNascita
  codiceFiscale
}

class Indirizzo {
  nazione
  provincia
  comune
  cap
  indirizzo
  civico
  scala
  interno
}

class DocumentoRiconoscimento {
  tipo
  organoEmittente
  dataRilascio
  dataScadenza
  numero
}

class Immobile {
  nome
}

class DatiCatastali {
  codiceComunale
  foglio
  particella
  subalterno
  categoria
  consistenza
  rendita
}

class Contratto {
  nomeDescrizione
  dal
  al
  canoneMensile
  giornoPagamento
}

class TipologiaContrattuale {
  denominazione
  durataPeriodoIniziale
}

class Clausola {
  testo
}

class Pagamento {
  meseCompetenza
  dataPagamento
}

Persona "0..*" -- "1" Indirizzo : residenza
Immobile "0..*" -- "1" Indirizzo : ubicazione
Persona "1" -- "0..1" DocumentoRiconoscimento : documento

Immobile "1" -- "1" DatiCatastali : dati catastali
Immobile "1" -- "0..*" Contratto : oggetto della locazione

Persona "1" -- "0..*" Contratto : proprietario
Persona "1" -- "0..*" Contratto : inquilino

TipologiaContrattuale "1" -- "0..*" Contratto : tipologia
TipologiaContrattuale "1" -- "1..*" Clausola : clausole predefinite

Contratto "1" -- "1..*" Pagamento : pagamenti

note right of Persona
  { codiceFiscale univoco }
  { se assume il ruolo di inquilino,
    DocumentoRiconoscimento presente }
end note

note bottom of DatiCatastali
  { codiceComunale + foglio + particella +
    subalterno identificano univocamente l'Immobile }
end note

note bottom of Indirizzo
  { per l'Immobile, se interno è specificato,
    l'indirizzo completo non può duplicare
    quello di un altro Immobile }
end note

note right of Contratto
  { giornoPagamento in 1..28 }
  { al determinato da dal e TipologiaContrattuale }
  { periodi relativi allo stesso Immobile
    non sovrapposti }
end note

note bottom of Pagamento
  { al massimo un Pagamento per meseCompetenza
    dello stesso Contratto }
  { alla registrazione del Contratto esiste già
    il Pagamento della prima mensilità }
end note

@enduml
