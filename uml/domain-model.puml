@startuml

title Gestionale Affitti — Domain Model

left to right direction
hide methods
hide stereotypes
skinparam classAttributeIconSize 0

class Persona {
  nome
  cognome
  luogoNascita
  dataNascita
  codiceFiscale
}

class Indirizzo {
  nazione
  provincia
  comune
  cap
  indirizzo
  civico
  scala
  interno
}

class DocumentoRiconoscimento {
  tipo
  organoEmittente
  dataRilascio
  dataScadenza
  numero
}

class Immobile {
  nome
}

class DatiCatastali {
  codiceComunale
  foglio
  particella
  subalterno
  categoria
  consistenza
  rendita
}

class Contratto {
  nomeDescrizione
  dal
  /al
  canoneMensile
  giornoPagamento
}

class TipologiaContrattuale {
  denominazione
  durata
  rinnovo
}

class ArticoloPredefinito {
  numArticolo
  titolo
  sottotitolo
  testo
}

class ArticoloContratto {
  numArticolo
  titolo
  sottotitolo
  testo
}

class Pagamento {
  annoCompetenza
  meseCompetenza
  dataPagamento
  importo
}

Persona "0..*" -- "1" Indirizzo : residenza
Immobile "0..*" -- "1" Indirizzo : ubicazione
Persona "1" -- "0..1" DocumentoRiconoscimento : documento

Immobile "1" -- "1" DatiCatastali : dati catastali
Immobile "1" -- "0..*" Contratto : oggetto della locazione

Persona "1" -- "0..*" Contratto : proprietario
Persona "1" -- "0..*" Contratto : inquilino

TipologiaContrattuale "1" -- "0..*" Contratto : tipologia
TipologiaContrattuale "1" -- "1..*" ArticoloPredefinito : articoli predefiniti

Contratto "1" -- "1..*" ArticoloContratto : articoli registrati
Contratto "1" -- "1..*" Pagamento : pagamenti

note right of Persona
  { codiceFiscale univoco }
  { se assume il ruolo di inquilino,
    DocumentoRiconoscimento presente }
end note

note right of DocumentoRiconoscimento
  { tipo = carta d'identità oppure passaporto }
end note

note bottom of DatiCatastali
  { codiceComunale + foglio + particella +
    subalterno identificano univocamente l'Immobile }
end note

note bottom of Indirizzo
  { per l'Immobile, se interno è specificato,
    l'indirizzo completo non può duplicare
    quello di un altro Immobile }
end note

note right of Contratto
  { giornoPagamento in 1..28 }
  { /al determinato da dal e TipologiaContrattuale.durata }
  { periodi relativi allo stesso Immobile
    non sovrapposti }
end note

note bottom of TipologiaContrattuale
  { durata e rinnovo espressi in anni }
  { v1.0: concordato durata=3, rinnovo=2;
    libero durata=4, rinnovo=4 }
  { il rinnovo non estende il periodo gestito in v1.0 }
end note

note bottom of ArticoloContratto
  { copia storica valorizzata degli articoli predefiniti }
  { indipendente da successive modifiche
    degli articoli predefiniti o dei dati sorgente }
end note

note bottom of Pagamento
  { meseCompetenza in 1..12 }
  { al massimo un Pagamento per annoCompetenza +
    meseCompetenza dello stesso Contratto }
  { importo = canoneMensile al momento della registrazione }
  { prima mensilità: anno/mese da Contratto.dal,
    dataPagamento = Contratto.dal }
end note

@enduml
