@startuml
title UC-01 — Registrare un contratto di locazione

actor Proprietario
boundary "Interfaccia UC-01" as UI
control "RegistraContrattoService" as UC
participant "Repository bozze" as Draft
database "Repository dati definitivi" as Store
participant "GeneratoreDocumentoContratto" as Generator
participant "Contratto" as Contract
participant "Pagamento" as Payment

note over UI,UC
La procedura presenta cinque step.
I primi quattro acquisiscono dati; il quinto è il riepilogo.
stepCompletato resta quindi compreso fra 0 e 4.
end note

Proprietario -> UI : avvia UC-01
UI -> UC : avvia()
UC -> Draft : elenca()
Draft --> UC : List<BozzaContratto>

loop per ogni bozza persistita
  alt dati sufficienti per riconoscere un residuo
    UC -> Store : recupera Immobile/Contratti necessari
    Store --> UC : dati definitivi
    UC -> UC : confronta catasto + CF inquilino + dal/al
    alt coincide con Contratto già registrato
      UC -> Draft : elimina(idBozza)
    else non coincide
      UC -> UC : mantiene bozza riprendibile
    end
  else dati insufficienti
    UC -> UC : mantiene bozza riprendibile
  end
end
UC --> UI : bozze riprendibili

alt esistono bozze riprendibili
  UI --> Proprietario : mostra Riprendi / Annulla per ciascuna bozza\ne Nuovo contratto
  alt annulla una bozza dall'elenco
    Proprietario -> UI : annulla bozza idBozza
    UI -> UC : annulla(idBozza)
    UC -> Draft : trovaPerId(idBozza)
    Draft --> UC : BozzaContratto
    UC -> Draft : elimina(idBozza)
    UC --> UI : bozza eliminata
  else riprende una bozza
    Proprietario -> UI : seleziona idBozza
    UI --> Proprietario : mostra primo step non completato\no riepilogo se i primi 4 sono completi
  else nuova procedura
    UI --> Proprietario : mostra Step 1 senza idBozza
  end
else nessuna bozza
  UI --> Proprietario : mostra Step 1 senza idBozza
end

group Step 1 — Immobile
  UI -> UC : elencaImmobili()
  UC -> Store : trovaTutti()
  Store --> UC : List<Immobile>
  UC --> UI : immobili

  Proprietario -> UI : seleziona immobile esistente\noppure inserisce nuovo immobile
  alt immobile esistente
    UI -> UC : selezionaImmobile(immobileId, idBozza?)
    UC -> Store : trovaPerId(immobileId)
    Store --> UC : Immobile | null
    alt non trovato
      UC --> UI : errore
    else trovato
      UC -> Draft : trovaPerImmobileId(immobileId)
      Draft --> UC : BozzaContratto | null
      alt altra bozza sullo stesso Immobile
        UC --> UI : conflitto
      else disponibile
        UC -> Draft : salva(bozza)
        Draft --> UC : BozzaContratto con idBozza
        UC --> UI : Step 2
      end
    end
  else nuovo immobile
    UI -> UC : inserisciNuovoImmobile(immobile, idBozza?)
    UC -> Store : verifica duplicato catastale\ne, se applicabile, indirizzo completo
    Store --> UC : esito
    alt duplicato / dati non validi
      UC --> UI : errore
    else valido
      UC -> Draft : salva(bozza)
      Draft --> UC : BozzaContratto con idBozza
      UC --> UI : Step 2
    end
  end
end

group Step 2 — Proprietario
  alt ricerca Persona esistente
    Proprietario -> UI : inserisce codice fiscale e Cerca
    UI -> UC : cercaPersonaPerBozza(idBozza, proprietario, CF)
    UC -> Draft : trovaPerId(idBozza)
    Draft --> UC : BozzaContratto
    UC -> Store : trovaPerCodiceFiscale(CF)
    Store --> UC : Persona | null
    UC --> UI : working copy | null
  else inserimento diretto nuova Persona
    Proprietario -> UI : Nuovo proprietario\ne compila i dati
  end
  Proprietario -> UI : salva proprietario
  UI -> UC : impostaProprietario(idBozza, persona)
  UC -> Draft : trovaPerId(idBozza)
  Draft --> UC : BozzaContratto
  UC -> UC : valida CF, età e ruolo distinto
  opt persona senza id persistito
    UC -> Store : trovaPerCodiceFiscale(CF)
    Store --> UC : Persona | null
  end
  alt CF già registrato nell'inserimento diretto\no altri dati non validi
    UC --> UI : errore; usare ricerca se Persona già esiste
  else valido
    UC -> Draft : salva(bozza con proprietario)
    Draft --> UC : BozzaContratto
    UC --> UI : Step 3
  end
end

group Step 3 — Inquilino
  alt ricerca Persona esistente
    Proprietario -> UI : inserisce codice fiscale e Cerca
    UI -> UC : cercaPersonaPerBozza(idBozza, inquilino, CF)
    UC -> Draft : trovaPerId(idBozza)
    Draft --> UC : BozzaContratto
    UC -> Store : trovaPerCodiceFiscale(CF)
    Store --> UC : Persona | null
    UC --> UI : working copy | null
  else inserimento diretto nuova Persona
    Proprietario -> UI : Nuovo inquilino\ne compila dati + documento
  end
  Proprietario -> UI : salva inquilino
  UI -> UC : impostaInquilino(idBozza, persona)
  UC -> Draft : trovaPerId(idBozza)
  Draft --> UC : BozzaContratto
  UC -> UC : valida CF, età, ruoli distinti\ne presenza documento
  UC -> UC : oggi = DataCorrenteProvider.oggi()
  UC -> UC : documento.validaRilascioAlla(oggi)\ndocumento.validaScadenzaAlla(oggi)
  opt persona senza id persistito
    UC -> Store : trovaPerCodiceFiscale(CF)
    Store --> UC : Persona | null
  end
  alt dati/documento non validi o CF già registrato\nnell'inserimento diretto
    UC --> UI : errore
  else valido
    UC -> Draft : salva(bozza con inquilino)
    Draft --> UC : BozzaContratto
    UC --> UI : Step 4
  end
end

group Step 4 — Dati contrattuali
  UI -> UC : elencaTipologie()
  UC -> Store : trovaTutte()
  Store --> UC : List<TipologiaContrattuale>
  UC --> UI : tipologie (senza mostrare articoli nello Step 4)

  Proprietario -> UI : inserisce nome/descrizione, tipologia, dal,\ncanoneMensile, giornoPagamento
  UI -> UC : impostaDatiContrattuali(...)
  UC -> Draft : trovaPerId(idBozza)
  Draft --> UC : BozzaContratto
  UC -> Store : trovaPerIdConArticoli(tipologiaId)
  Store --> UC : TipologiaContrattuale + Articoli
  alt template richiede proprietario.iban e IBAN assente
    UC --> UI : errore; completare Step 2
  else dati validi
    UC -> Contract : calcolaDataFine(dal, tipologia)
    Contract --> UC : al
    UC -> Draft : salva(bozza con dati e al)
    Draft --> UC : BozzaContratto
    UC --> UI : Step 5 — Riepilogo
  end
end

group Step 5 — Riepilogo
  UI -> UC : anteprima(idBozza)
  UC -> Draft : trovaPerId(idBozza)
  Draft --> UC : BozzaContratto completa
  UC -> UC : rivalida età, documento, CF distinti,\nIBAN richiesto e dati contrattuali
  UC -> Contract : costruisce Contratto transitorio
  Contract --> UC : Contratto
  UC -> Generator : genera(contratto)
  Generator --> UC : HTML valorizzato
  UC --> UI : HTML anteprima
  note over UC,Generator
    Nessuna scrittura definitiva, nessun Pagamento,
    nessun contenuto storico viene persistito nell'anteprima.
  end note
  UI --> Proprietario : mostra dati + articoli valorizzati

  opt modifica di uno step già completato
    Proprietario -> UI : seleziona direttamente Step 1..4
    UI --> Proprietario : mostra step scelto
    Proprietario -> UI : salva modifica
    UI -> UC : richiama operazione dello step con idBozza
    UC -> Draft : salva bozza aggiornata
    UC --> UI : torna al riepilogo e rigenera anteprima
  end

  alt Salva bozza ed esci
    Proprietario -> UI : salva bozza ed esci
    note right of UI
      I quattro step sono già stati persistiti progressivamente.
      Non serve una nuova scrittura applicativa.
    end note
    UI --> Proprietario : torna alla schermata iniziale UC-01\nlasciando la bozza riprendibile
  else Annulla bozza
    Proprietario -> UI : annulla bozza
    UI -> UC : annulla(idBozza)
    UC -> Draft : elimina(idBozza)
    UC --> UI : annullamento completato
  else Conferma e registra
    Proprietario -> UI : conferma e registra
    UI -> UC : conferma(idBozza)
    UC -> Draft : trovaPerId(idBozza)
    Draft --> UC : BozzaContratto
    UC -> UC : rivalida dati usando data corrente
    UC -> Contract : ricostruisce Contratto dai dati finali
    Contract --> UC : Contratto
    opt Immobile già persistito
      UC -> Store : esisteSovrapposizione(immobileId, dal, al)
      Store --> UC : boolean
    end
    alt periodo sovrapposto
      UC --> UI : errore; bozza invariata
    else periodo disponibile
      UC -> Generator : genera(contratto)
      Generator --> UC : HTML definitivo
      UC -> Contract : impostaContenuto(HTML)
      UC -> Payment : crea prima mensilità
      Payment --> UC : Pagamento
      UC -> Contract : aggiungiPagamento(pagamento)
      UC -> Store : registraDefinitivamente(contratto)
      alt registrazione fallita
        Store --> UC : errore / rollback
        UC --> UI : errore; bozza disponibile
      else registrazione riuscita
        Store --> UC : ok
        UC -> Draft : elimina(idBozza)
        note right of Draft
          Un eventuale errore di cleanup non annulla
          la registrazione definitiva già completata.
        end note
        UC --> UI : registrazione completata
      end
    end
  end
end

@enduml
