@startuml
title UC-01 — Registrare un contratto di locazione

actor Proprietario
boundary "Interfaccia UC-01" as UI
control "Gestione UC-01" as UC
participant "Repository bozze" as Draft
database "Archivio dati definitivi" as Store
participant "Contratto" as Contract
participant "Pagamento" as Payment

note over UI,UC
I partecipanti applicativi sono ruoli logici.
Le operazioni pubbliche richiamate sono mantenute
coerenti con il Class Diagram.
end note

Proprietario -> UI : avvia registrazione contratto
UI -> UC : avvia()
UC -> Draft : elenca()
Draft --> UC : List<BozzaContratto>

loop per ogni bozza persistita
    alt dati sufficienti al confronto
        UC -> Store : trova Immobile persistito e Contratti dell'Immobile
        Store --> UC : dati persistiti
        UC -> UC : confronta dati catastali, CF inquilino, dal e al
        alt corrispondenza completa con un Contratto registrato
            UC -> Draft : elimina(idBozza)
            note right of Draft
            La bozza è residua di una registrazione
            già completata e non viene proposta.
            end note
        else nessuna corrispondenza completa
            UC -> UC : mantiene la bozza tra quelle riprendibili
        end
    else dati insufficienti
        UC -> UC : mantiene la bozza tra quelle riprendibili
    end
end

UC --> UI : List<BozzaContratto> riprendibili

alt almeno una bozza riprendibile
    UI --> Proprietario : mostra bozze disponibili e azione Nuovo contratto
    alt proprietario sceglie una bozza
        Proprietario -> UI : seleziona idBozza
        UI --> Proprietario : mostra dati recuperati e primo step non completato
    else proprietario sceglie Nuovo contratto
        UI --> Proprietario : mostra Step 1 senza idBozza
    end
else nessuna bozza riprendibile
    UI --> Proprietario : mostra Step 1 senza idBozza
end

group Step 1 — Immobile
    UI -> UC : elencaImmobili()
    UC -> Store : trovaTutti()
    Store --> UC : List<Immobile>
    UC --> UI : immobili disponibili

    Proprietario -> UI : seleziona immobile esistente\noppure inserisce nuovo immobile

    alt seleziona immobile esistente
        UI -> UC : selezionaImmobile(immobileId, idBozza?)
        UC -> Store : trovaPerId(immobileId)

        alt immobile non trovato
            Store --> UC : null
            UC --> UI : mostra errore
        else immobile trovato
            Store --> UC : Immobile
            UC -> Draft : trovaPerImmobileId(immobileId)
            Draft --> UC : BozzaContratto | null

            alt esiste un'altra bozza attiva per l'Immobile
                UC --> UI : segnala bozza già esistente
            else immobile disponibile per la bozza corrente
                UC -> Draft : salva(nuova bozza o bozza idBozza aggiornata)
                Draft --> UC : BozzaContratto con idBozza
                UC --> UI : mostra Step 2
            end
        end

    else inserisce nuovo immobile
        UI -> UC : inserisciNuovoImmobile(immobile, idBozza?)
        UC -> UC : valida dati del nuovo Immobile

        alt dati non validi
            UC --> UI : mostra errori di validazione
        else dati validi
            UC -> Store : trovaPerDatiCatastali(datiCatastali)
            alt duplicato catastale
                Store --> UC : Immobile
                UC --> UI : segnala duplicato catastale
            else nessun duplicato catastale
                Store --> UC : null
                opt interno specificato
                    UC -> Store : esisteConIndirizzo(indirizzo)
                    Store --> UC : boolean
                end

                alt indirizzo completo duplicato
                    UC --> UI : segnala duplicato indirizzo
                else nuovo Immobile accettabile
                    UC -> Draft : salva(nuova bozza o bozza idBozza aggiornata)
                    Draft --> UC : BozzaContratto con idBozza
                    note right of Draft
                    Il nuovo Immobile resta soltanto nei dati
                    della bozza fino alla conferma definitiva.
                    end note
                    UC --> UI : mostra Step 2
                end
            end
        end
    end
end

loop per ruolo [proprietario, inquilino]
    Proprietario -> UI : inserisce codice fiscale
    UI -> UC : cercaPersona(codiceFiscale)
    UC -> Store : trovaPerCodiceFiscale(codiceFiscale)

    alt Persona già registrata
        Store --> UC : Persona
        UC --> UI : mostra working copy precompilata
        Proprietario -> UI : verifica / modifica dati consentiti
    else Persona non registrata
        Store --> UC : null
        UC --> UI : richiede dati Persona
        Proprietario -> UI : inserisce dati Persona
    end

    opt ruolo = inquilino e documento assente o da correggere
        UC --> UI : richiede / consente modifica documento
        Proprietario -> UI : inserisce / modifica documento
    end

    alt ruolo = proprietario
        UI -> UC : impostaProprietario(idBozza, persona)
    else ruolo = inquilino
        UI -> UC : impostaInquilino(idBozza, persona)
    end

    UC -> Draft : trovaPerId(idBozza)
    Draft --> UC : BozzaContratto
    UC -> UC : valida step e dati del ruolo

    alt dati non validi
        UC --> UI : mostra errori
    else dati validi
        UC -> Draft : salva(bozza aggiornata)
        Draft --> UC : BozzaContratto
    end
end

group Step 4 — Dati contrattuali
    UI -> UC : elencaTipologie()
    UC -> Store : trovaTutte()
    Store --> UC : List<TipologiaContrattuale>
    UC --> UI : tipologie disponibili

    Proprietario -> UI : seleziona tipologia ed inserisce nome/descrizione, dal,\ncanoneMensile, giornoPagamento
    UI -> UC : impostaDatiContrattuali(idBozza, nomeDescrizione,\ntipologiaId, dal, canoneMensile, giornoPagamento)
    UC -> Draft : trovaPerId(idBozza)
    Draft --> UC : BozzaContratto
    UC -> Store : trovaPerIdConArticoli(tipologiaId)
    Store --> UC : TipologiaContrattuale + Articoli
    UC -> UC : al = Contratto.calcolaDataFine(dal, tipologia)
    UC -> Draft : salva(bozza con dal e al calcolato)
    Draft --> UC : BozzaContratto
    UC --> UI : mostra riepilogo
end

opt modifica dal riepilogo
    Proprietario -> UI : modifica dati
    UI -> UC : richiama l'operazione dello step modificato con idBozza
    UC -> Draft : salva(bozza aggiornata)
    UC --> UI : mostra riepilogo aggiornato
end

alt proprietario annulla
    Proprietario -> UI : annulla
    UI -> UC : annulla(idBozza)
    UC -> Draft : trovaPerId(idBozza)
    Draft --> UC : BozzaContratto
    UC -> Draft : elimina(idBozza)
    UC --> UI : conferma annullamento
else proprietario conferma
    Proprietario -> UI : conferma
    UI -> UC : conferma(idBozza)
    UC -> Draft : trovaPerId(idBozza)
    Draft --> UC : BozzaContratto con dal e al

    opt Immobile già persistito
        UC -> Store : esisteSovrapposizione(immobileId, dal, al)
        Store --> UC : boolean
    end

    alt periodo sovrapposto
        UC --> UI : mostra errore di sovrapposizione
        note right of Draft
        La bozza identificata da idBozza resta disponibile.
        end note
    else periodo disponibile
        UC -> UC : acquisisce data corrente tramite DataCorrenteProvider
        UC -> Contract : costruisci(dati finali validati, dal, al, registratoIl)
        Contract --> UC : Contratto in assemblaggio

        UC -> UC : genera documento HTML tramite GeneratoreDocumentoContratto
        UC -> Contract : impostaContenuto(documento HTML)

        UC -> Payment : crea prima mensilità(anno/mese da dal,\ndataPagamento = dal, importo calcolato)
        Payment --> UC : Pagamento
        UC -> Contract : aggiungiPagamento(pagamento)

        UC -> Store : registraDefinitivamente(contratto)

        alt registrazione definitiva riuscita
            Store --> UC : Promise risolta
            UC -> Draft : elimina(idBozza)
            alt eliminazione bozza riuscita
                Draft --> UC : ok
                UC --> UI : registrazione completata
            else errore di cleanup della bozza
                Draft --> UC : errore
                note over UC,Draft
                Il Contratto resta validamente registrato.
                Solo la bozza corrente resta residua e sarà
                riconosciuta al successivo avvio.
                end note
                UC --> UI : registrazione completata
            end
        else errore di registrazione definitiva
            Store --> UC : errore
            UC --> UI : mostra errore
            note over Draft,Store
            Nessun dato definitivo resta salvato parzialmente;
            la bozza corrente rimane disponibile.
            end note
        end
    end
end

@enduml
