@startuml

title Gestionale Affitti — Class Diagram di design

left to right direction
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
hide empty members

package "application" {
  class RegistraContrattoService <<service>> {
    + avvia(): Promise<List<BozzaContratto>>
    + elencaImmobili(): Promise<List<Immobile>>
    + elencaTipologie(): Promise<List<TipologiaContrattuale>>
    + selezionaImmobile(immobileId : int, idBozza : int [0..1]): Promise<BozzaContratto>
    + inserisciNuovoImmobile(immobile : Immobile, idBozza : int [0..1]): Promise<BozzaContratto>
    + cercaPersona(codiceFiscale : string): Promise<Persona | null>
    + cercaPersonaPerBozza(idBozza : int, ruolo : string, codiceFiscale : string): Promise<Persona | null>
    + impostaProprietario(idBozza : int, persona : Persona): Promise<BozzaContratto>
    + impostaInquilino(idBozza : int, persona : Persona): Promise<BozzaContratto>
    + impostaDatiContrattuali(idBozza : int, nomeDescrizione : string, tipologiaId : int, dal : date, canoneMensile : decimal, giornoPagamento : int): Promise<BozzaContratto>
    + anteprima(idBozza : int): Promise<string>
    + conferma(idBozza : int): Promise<void>
    + annulla(idBozza : int): Promise<void>
  }

  class RegistraPagamentoService <<service>> {
    + elencaImmobili(): Promise<List<Immobile>>
    + elencaInquilini(immobileId : int): Promise<List<Persona>>
    + preparaPagamento(immobileId : int, inquilinoId : int): Promise<PagamentoDaRegistrare | null>
    + confermaPagamento(contrattoId : int, annoCompetenza : int, meseCompetenza : int): Promise<Pagamento>
  }

  package "model" {
    class BozzaContratto <<application model>> {
      - idBozza : int [0..1]
      - stepCompletato : int
      - nomeDescrizione : string [0..1]
      - dal : date [0..1]
      - al : date [0..1]
      - canoneMensile : decimal [0..1]
      - giornoPagamento : int [0..1]
    }

    class PagamentoDaRegistrare <<application model>> {
      - contrattoId : int
      - canoneMensile : decimal
      - tipologiaDenominazione : string
      - dal : date
      - al : date
      - annoCompetenza : int
      - meseCompetenza : int
      - scadenza : date
      - importo : decimal
      - dovuta : boolean
      - tardivo : boolean
    }
  }

  package "ports" {
    interface BozzaContrattoRepository {
      + elenca(): Promise<List<BozzaContratto>>
      + trovaPerId(idBozza : int): Promise<BozzaContratto | null>
      + trovaPerImmobileId(immobileId : int): Promise<BozzaContratto | null>
      + salva(bozza : BozzaContratto): Promise<BozzaContratto>
      + elimina(idBozza : int): Promise<void>
    }

    interface ImmobileRepository {
      + trovaTutti(): Promise<List<Immobile>>
      + trovaPerId(id : int): Promise<Immobile | null>
      + trovaPerDatiCatastali(dati : DatiCatastali): Promise<Immobile | null>
      + esisteConIndirizzo(indirizzo : Indirizzo): Promise<boolean>
    }

    interface PersonaRepository {
      + trovaPerCodiceFiscale(codiceFiscale : string): Promise<Persona | null>
    }

    interface TipologiaContrattualeRepository {
      + trovaTutte(): Promise<List<TipologiaContrattuale>>
      + trovaPerIdConArticoli(id : int): Promise<TipologiaContrattuale | null>
    }

    interface ContrattoRepository {
      + trovaPerId(id : int): Promise<Contratto | null>
      + trovaPerImmobile(immobileId : int): Promise<List<Contratto>>
      + esisteSovrapposizione(immobileId : int, dal : date, al : date): Promise<boolean>
    }

    interface PagamentoRepository {
      + salva(contrattoId : int, pagamento : Pagamento): Promise<void>
    }

    interface RegistrazioneContrattoPort {
      + registraDefinitivamente(contratto : Contratto): Promise<void>
    }

    interface GeneratoreDocumentoContratto {
      + genera(contratto : Contratto) : string
    }

    interface DataCorrenteProvider {
      + oggi() : date
    }
  }
}

package "web" {
  class RegistraContrattoController <<controller>> {
    + router : Router
  }

  class compositionRoot <<module>> {
    + creaApplicazioneProduzione(): ApplicazioneProduzione
  }
}

package "domain" {
  class Persona {
    - id : int [0..1]
    - nome : string
    - cognome : string
    - luogoNascita : string
    - dataNascita : date
    - codiceFiscale : string
    - iban : string [0..1]
    + {static} normalizzaCodiceFiscale(codiceFiscale : string) : string
    + {static} validaDataNascita(dataNascita : date, oggi : date) : void
    + aggiornaDatiAnagrafici(nome : string, cognome : string, luogoNascita : string, dataNascita : date) : void
    + cambiaResidenza(residenza : Indirizzo) : void
    + impostaDocumentoRiconoscimento(documento : DocumentoRiconoscimento) : void
  }

  class Indirizzo {
    - id : int [0..1]
    - nazione : string [0..1]
    - provincia : string
    - comune : string
    - cap : string [0..1]
    - indirizzo : string
    - civico : string [0..1]
    - scala : string [0..1]
    - interno : string [0..1]
  }

  class DocumentoRiconoscimento {
    - id : int [0..1]
    - tipo : string
    - organoEmittente : string
    - dataRilascio : date
    - dataScadenza : date
    - numero : string
    + validaRilascioAlla(oggi : date) : void
    + validaScadenzaAlla(oggi : date) : void
  }

  class Immobile {
    - id : int [0..1]
    - nome : string
  }

  class DatiCatastali {
    - id : int [0..1]
    - codiceComunale : string
    - foglio : int
    - particella : int
    - subalterno : int
    - categoria : string
    - consistenza : decimal
    - rendita : decimal
  }

  class TipologiaContrattuale {
    - id : int [0..1]
    - denominazione : string
    - durata : int
    - rinnovo : int
  }

  class Articolo {
    - id : int [0..1]
    - numArticolo : int
    - numParte : int
    - titolo : string
    - sottotitolo : string [0..1]
    - descrizione : string
  }

  class Contratto {
    - id : int [0..1]
    - nomeDescrizione : string
    - dal : date
    - al : date
    - canoneMensile : decimal
    + /canoneAnnuale : decimal
    - giornoPagamento : int
    - registratoIl : date
    - contenuto : string [0..1]
    + siSovrapponeA(altro : Contratto) : boolean
    + calcolaImportoCompetenza(anno : int, mese : int) : decimal
    + calcolaScadenzaCompetenza(anno : int, mese : int) : date
    + {static} validaGiornoPagamento(giornoPagamento : int) : void
    + {static} periodiSiSovrappongono(dal : date, al : date, altroDal : date, altroAl : date) : boolean
    + {static} calcolaDataFine(dal : date, tipologia : TipologiaContrattuale) : date
    + statoAlla(data : date) : string
    + impostaContenuto(contenuto : string) : void
    + aggiungiPagamento(pagamento : Pagamento) : void
  }

  class Pagamento {
    - id : int [0..1]
    - annoCompetenza : int
    - meseCompetenza : int
    - dataPagamento : date
    - importo : decimal
  }
}

package "infrastructure" {
  package "persistence.postgres" {
    class PostgresBozzaContrattoRepository <<repository>>
    class PostgresImmobileRepository <<repository>>
    class PostgresPersonaRepository <<repository>>
    class PostgresTipologiaContrattualeRepository <<repository>>
    class PostgresContrattoRepository <<repository>>
    class PostgresRegistrazioneContratto <<transactional adapter>> {
      + registraDefinitivamente(contratto : Contratto): Promise<void>
    }
    class BozzaContrattoJsonMapper <<mapper>>
    class PostgresValueMapper <<mapper>>
  }

  package "document" {
    class GeneratoreDocumentoHtmlContratto <<generator>> {
      + genera(contratto : Contratto): string
    }
  }

  package "time" {
    class DataCorrenteSistemaProvider <<provider>> {
      + oggi(): date
    }
  }
}

Persona "0..*" -- "1" Indirizzo : residenza
Persona "1" -- "0..1" DocumentoRiconoscimento : documento
Immobile "0..*" -- "1" Indirizzo : ubicazione
Immobile "1" -- "1" DatiCatastali : dati catastali
Immobile "1" -- "0..*" Contratto : oggetto della locazione
Persona "1" -- "0..*" Contratto : proprietario
Persona "1" -- "0..*" Contratto : inquilino
TipologiaContrattuale "1" -- "0..*" Contratto : tipologia
TipologiaContrattuale "1" -- "1..*" Articolo : articoli predefiniti
Contratto "1" -- "0..*" Pagamento : pagamenti

BozzaContratto "1" --> "0..1" Immobile : immobile
BozzaContratto "1" --> "0..1" Persona : proprietario
BozzaContratto "1" --> "0..1" Persona : inquilino
BozzaContratto "1" --> "0..1" TipologiaContrattuale : tipologia

RegistraContrattoController ..> RegistraContrattoService
compositionRoot ..> RegistraContrattoService
compositionRoot ..> PostgresBozzaContrattoRepository
compositionRoot ..> PostgresImmobileRepository
compositionRoot ..> PostgresPersonaRepository
compositionRoot ..> PostgresTipologiaContrattualeRepository
compositionRoot ..> PostgresContrattoRepository
compositionRoot ..> PostgresRegistrazioneContratto
compositionRoot ..> GeneratoreDocumentoHtmlContratto
compositionRoot ..> DataCorrenteSistemaProvider

RegistraContrattoService ..> BozzaContrattoRepository
RegistraContrattoService ..> ImmobileRepository
RegistraContrattoService ..> PersonaRepository
RegistraContrattoService ..> TipologiaContrattualeRepository
RegistraContrattoService ..> ContrattoRepository
RegistraContrattoService ..> RegistrazioneContrattoPort
RegistraContrattoService ..> GeneratoreDocumentoContratto
RegistraContrattoService ..> DataCorrenteProvider

note right of RegistraContrattoService
  L'anteprima costruisce un Contratto transitorio
  dalla bozza completa e usa lo stesso generatore
  della conferma senza produrre scritture definitive.
  Alla conferma il Contratto viene ricostruito e
  il documento viene rigenerato dai dati rivalidati.
end note

RegistraPagamentoService ..> ImmobileRepository
RegistraPagamentoService ..> ContrattoRepository
RegistraPagamentoService ..> PagamentoRepository
RegistraPagamentoService ..> DataCorrenteProvider
RegistraPagamentoService ..> PagamentoDaRegistrare

PostgresBozzaContrattoRepository ..|> BozzaContrattoRepository
PostgresImmobileRepository ..|> ImmobileRepository
PostgresPersonaRepository ..|> PersonaRepository
PostgresTipologiaContrattualeRepository ..|> TipologiaContrattualeRepository
PostgresContrattoRepository ..|> ContrattoRepository
PostgresRegistrazioneContratto ..|> RegistrazioneContrattoPort
GeneratoreDocumentoHtmlContratto ..|> GeneratoreDocumentoContratto
DataCorrenteSistemaProvider ..|> DataCorrenteProvider

PostgresBozzaContrattoRepository ..> BozzaContrattoJsonMapper
PostgresContrattoRepository ..> PostgresValueMapper
PostgresImmobileRepository ..> PostgresValueMapper
PostgresPersonaRepository ..> PostgresValueMapper
PostgresRegistrazioneContratto ..> PostgresValueMapper

RegistrazioneContrattoPort ..> Contratto
GeneratoreDocumentoContratto ..> Contratto

note right of RegistraContrattoController
  Confine HTTP di UC-01: traduce JSON in input applicativi,
  invoca il Service e serializza le risposte.
  Espone anche l'anteprima HTML della bozza completa.
  Le date di calendario attraversano HTTP come YYYY-MM-DD.
  Non contiene regole di dominio o query SQL.
end note

note right of compositionRoot
  Unico punto di assemblaggio delle dipendenze concrete.
  Costruisce pool, repository, adapter e provider
  e li inietta nel RegistraContrattoService.
end note

note right of GeneratoreDocumentoHtmlContratto
  I template sono testo con placeholder espliciti {{...}}.
  I placeholder supportati sono una lista chiusa;
  valori e template vengono HTML-escaped.
  numArticolo e numParte determinano soltanto l'ordine.
end note

note right of DataCorrenteSistemaProvider
  Usa la data di calendario dell'orologio del processo
  e la normalizza a mezzanotte UTC per il modello date-only.
end note

note right of Persona
  In UC-01 id e codiceFiscale non vengono modificati.
  Il codice fiscale viene normalizzato e validato
  strutturalmente, ammettendo l'omocodia.
  L'IBAN è opzionale e appartiene alla Persona;
  il template può richiederlo al proprietario.
  La data di nascita deve corrispondere a un'età
  compresa tra 18 e 150 anni rispetto alla data server.
  I dati recuperati sono una working copy verificabile
  e modificabile prima della conferma definitiva.
end note

note right of DocumentoRiconoscimento
  In UC-01 il documento usato dall'inquilino
  deve avere dataRilascio non successiva e
  dataScadenza strettamente successiva alla data
  corrente fornita dal DataCorrenteProvider.
  La validazione viene ripetuta per anteprima e conferma.
end note

note right of Indirizzo
  Nazione, CAP, civico, scala e interno sono opzionali:
  non sono dati universalmente disponibili né per
  l'ubicazione di un Immobile né per la residenza.
end note

note right of PagamentoRepository
  Porta di scrittura di UC-02.
  I Pagamenti esistenti vengono ricostruiti
  con il Contratto tramite ContrattoRepository.
end note

note right of RegistrazioneContrattoPort
  { pre: il Contratto da registrare possiede
  contenuto completo e almeno 1 Pagamento }
end note

note right of PostgresRegistrazioneContratto
  Implementa il confine transazionale di UC-01.
  Usa una singola connessione PostgreSQL:
  BEGIN -> dati definitivi collegati -> Contratto
  -> Pagamenti -> COMMIT; in caso di errore ROLLBACK.
  Il cleanup della Bozza resta esterno alla transazione.
end note

note bottom of BozzaContratto
  Application model temporaneo identificato da idBozza.
  Più bozze possono coesistere nella v1.0 mono-utente;
  per un Immobile già registrato è ammessa al massimo
  una bozza attiva. Conserva soltanto i dati necessari
  a riprendere la procedura. Conserva la tipologia selezionata
  con i template necessari alla ripresa, ma non contiene Contratto
  generato, documento HTML o Pagamenti definitivi.
end note

note bottom of Articolo
  Template della tipologia contrattuale.
  numArticolo identifica l'articolo logico;
  numParte ordina eventuali frammenti dello stesso articolo.
  I dati dinamici sono richiesti tramite placeholder {{...}}
  nel testo, non tramite convenzioni sui numeri degli articoli.
end note

note bottom of Contratto
  { proprietario.codiceFiscale <> inquilino.codiceFiscale }
  { giornoPagamento in 1..28 }
  { al calcolato da dal e tipologia.durata prima della registrazione
    e poi conservato come parte del periodo storico }
  { dal e al inclusivi }
  { registratoIl assegnato alla conferma tramite DataCorrenteProvider }
  Durante l'assemblaggio il contenuto può essere assente.
  Il GeneratoreDocumentoContratto produce l'HTML completo e
  il Service lo assegna prima della registrazione definitiva.
  { registrazione definitiva: contenuto presente e almeno 1 Pagamento }
  Lo stato futuro / in essere / scaduto è derivato e non persistito.
end note

note bottom of Pagamento
  { meseCompetenza in 1..12 }
  { univoco per Contratto + annoCompetenza + meseCompetenza }
end note

note bottom of PagamentoDaRegistrare
  Preview applicativa per la visualizzazione.
  Alla conferma Contratto e Pagamenti vengono ricaricati
  e i valori vengono ricalcolati lato server.
end note

note "Le operazioni dei Service che attraversano porte di persistenza sono asincrone.\nLe porte di persistenza restituiscono Promise perché le implementazioni concrete usano pg.\nGeneratoreDocumentoContratto e DataCorrenteProvider restano sincroni: nella v1.0 non richiedono I/O asincrono.\nGli id del design sono interi e vengono assegnati dalla persistenza PostgreSQL.\nIl contenuto storico del Contratto è una stringa HTML nella v1.0.\nIl confine HTTP riceve RegistraContrattoService per dependency injection e non costruisce dipendenze infrastrutturali.\nIl composition root è l'unico punto che conosce insieme web, application e implementazioni concrete dell'infrastruttura.\nLe implementazioni PostgreSQL realizzano le porte dell'application layer senza introdurre dipendenze da pg nei Service o nel dominio." as NDesign

@enduml
