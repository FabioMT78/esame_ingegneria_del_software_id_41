{
  "name": "gestionale-affitti",
  "version": "0.1.0",
  "private": true,
  "description": "Applicazione web per la gestione dei contratti e dei pagamenti per gli affitti ad uso abitativo",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "start": "node dist/web/server.js",
    "dev": "tsx watch src/web/server.ts",
    "db:seed:templates": "tsx src/infrastructure/persistence/postgres/SeedTemplateContrattualiCli.ts",
    "typecheck:test": "tsc --project test/tsconfig.json",
    "lint": "eslint src test public --max-warnings=0",
    "test": "jest",
    "verify": "npm run build && npm run typecheck:test && npm run lint && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FabioMT78/ingsw_25-26_group-41.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/FabioMT78/ingsw_25-26_group-41/issues"
  },
  "homepage": "https://github.com/FabioMT78/ingsw_25-26_group-41#readme",
  "dependencies": {
    "express": "^5.2.1",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.4",
    "@types/pg": "^8.23.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "jest": "^30.5.1",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  }
}
